# Local Postgres with pgvector
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/libriscope

# Embedding model (sentence-transformers/HF). Changing it auto-resizes the DB
EMBEDDINGS_MODEL=all-MiniLM-L6-v2
EMBED_BATCH_SIZE=192

# ETL tuning
PROCESSED_DIR=data/processed/openlibrary
BATCH_SIZE=64
MAX_AUX=500000

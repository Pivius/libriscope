# Database (local Postgres with pgvector)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/libriscope

# Ollama local embedding server
OLLAMA_HOST=http://localhost:11434
EMBEDDINGS_MODEL=mxbai-embed-large
EMBED_CONTEXT_LENGTH=512

# ETL tuning
PROCESSED_DIR=data/processed/openlibrary
BATCH_SIZE=32
MAX_AUX=500000

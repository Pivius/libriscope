# Database (local Postgres with pgvector)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/libriscope

# Embedding model
EMBEDDINGS_MODEL=gte-base-en-v1.5

# Optional embedding API key (only if using an OpenAI-compatible embedding endpoint)
OPENAI_API_KEY=

# ETL tuning
PROCESSED_DIR=data/processed/openlibrary
BATCH_SIZE=32
MAX_AUX=500000
